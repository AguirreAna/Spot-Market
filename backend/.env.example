# ─────────────────────────────────────────────────────────────
# Spot Market · configuración del backend
# ─────────────────────────────────────────────────────────────

# Motor de base de datos: sqlite (por defecto, cero configuración) | mysql
DB_DIALECT=sqlite

# Solo para sqlite: ruta del archivo de base de datos
DB_STORAGE=./data/spotmarket.sqlite

# Solo para MySQL (DB_DIALECT=mysql)
DB_NAME=spot_market
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306

# Puerto del servidor Express
PORT=4000

# Secreto para firmar los tokens JWT
JWT_SECRET=cambiar_este_secreto_en_produccion

# Entorno de ejecución (development | production)
NODE_ENV=development

# Carpeta donde se guardan las fotos subidas
UPLOAD_DIR=./uploads
