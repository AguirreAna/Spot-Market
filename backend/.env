# ==============================================================
# CONFIGURACIÓN SPOT MARKET - ENTORNO DE DESARROLLO (XAMPP / MySQL)
# ==============================================================

# Puerto de la API REST
PORT=4000
NODE_ENV=development

# Base de Datos MySQL (Configuración estándar de XAMPP phpMyAdmin)
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_PASS=
DB_NAME=spotmarket

# Clave secreta para firma de JSON Web Tokens (JWT)
JWT_SECRET=spotmarket_secreto_formosa_2026

# Orígenes permitidos para peticiones CORS (Frontend principal y Módulo Comerciante)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CLIENT_URL=http://localhost:5173

# Cloudinary (Opcional: Si se deja vacío, las imágenes se guardan automáticamente en disco local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
